    <description>Autolaunched processing flow invoked in bulk by the licensed-user Apex platform event subscriber. Update campaign display fields on the Lead or both Contact and Account, then send the generic_attend_seminar_confirmation WatBox template. Return synchronous faults to the subscriber for logging.</description>
    <environments>Default</environments>
    <formulas>
        <name>Recipient_Id_Prefix</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Current_Campaign_Member.LeadOrContactId}, 3)</expression>
    </formulas>
    <formulas>
        <name>Recipient_SObject_Name</name>
        <dataType>String</dataType>
        <expression>CASE({!Recipient_Id_Prefix}, &quot;00Q&quot;, &quot;Lead&quot;, &quot;003&quot;, &quot;Contact&quot;, &quot;&quot;)</expression>
    </formulas>
