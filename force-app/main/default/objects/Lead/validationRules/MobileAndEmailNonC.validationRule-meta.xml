<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MobileAndEmailNonC</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISPICKVAL(Data_Origin__c, &quot;C&quot;)),
ISBLANK(Mobile__c),
ISBLANK(Email),
RecordType.Name =&apos;Student&apos;
)</errorConditionFormula>
    <errorMessage>Please enter either Mobile or Email.</errorMessage>
</ValidationRule>
