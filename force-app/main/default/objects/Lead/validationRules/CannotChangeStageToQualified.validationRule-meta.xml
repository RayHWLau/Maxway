<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CannotChangeStageToQualified</fullName>
    <active>true</active>
    <errorConditionFormula>Text(PRIORVALUE(Status)) = &apos;Qualified&apos; &amp;&amp; Text(Status) != &apos;Qualified&apos;</errorConditionFormula>
    <errorMessage>Cannot Change Stage , once lead is &apos;Qualified&apos;.</errorMessage>
</ValidationRule>
