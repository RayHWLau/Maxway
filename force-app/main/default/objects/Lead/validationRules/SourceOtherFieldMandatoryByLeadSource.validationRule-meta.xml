<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SourceOtherFieldMandatoryByLeadSource</fullName>
    <active>false</active>
    <description>If lead source is Others then make Source Others field mandatory</description>
    <errorConditionFormula>AND(ISPICKVAL(LeadSource , &quot;Others&quot;), 
ISBLANK( Source_Others__c ))</errorConditionFormula>
    <errorMessage>Please enter Source other!</errorMessage>
</ValidationRule>
