<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Country_Code_Mandatory_Phone</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK( Phone )),ISBLANK(TEXT(Country_Code__c)), RecordType.Name =&apos;Agent&apos;)</errorConditionFormula>
    <errorMessage>Align values between country code and  phone</errorMessage>
</ValidationRule>
