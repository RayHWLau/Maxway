<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CountryCodeMandateWhenPhoneNotEpty</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(MobilePhone)),ISBLANK(TEXT(Country_Code__c)), RecordType.Name =&apos;Agent&apos;)</errorConditionFormula>
    <errorMessage>Align values between country code and mobile.</errorMessage>
</ValidationRule>
