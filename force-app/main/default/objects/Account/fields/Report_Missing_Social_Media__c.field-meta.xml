<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Report_Missing_Social_Media__c</fullName>
    <formula>OR(
	
		AND(
			OR(NOT(ISBLANK(WeChat_ID__pc)),NOT(ISBLANK(Social_Media_Others__pc))),
			Not(Add_client_to_Company_social_media__c)
		)
	,
	
		AND(
			OR(NOT(ISBLANK(Father_s_WeChat_ID__c)),NOT(ISBLANK(Father_s_Social_Media_Others__c))),
			Not(Add_Client_to_company_Social_Media_F__c)
		)
	,
	
		AND(
			OR(NOT(ISBLANK(Mother_s_WeChat_ID__c)),NOT(ISBLANK(Mother_s_Social_Media_Others__c))),
			Not(Add_Client_to_company_Social_Media_M__c)
		)
	
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Report Missing Social Media</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
