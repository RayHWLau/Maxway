<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IfLicenceendisreachedthenstatuspendingre</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Licence_End_Date__c &gt; Today(),ISBLANK(Licence_End_Date__c)) &amp;&amp;  Text(Status_Sub_Agent__c) =&apos;Pending Renewal&apos;</errorConditionFormula>
