    <fullName>IfCountryIsChina</fullName>
    <active>true</active>
    <errorConditionFormula>ISBLANK(Owner.ContactId) &amp;&amp; TEXT(Country_Residing__c)=&apos;China&apos; &amp;&amp;( ISBLANK(TEXT( Come_From_Province__c)) || ISBLANK(TEXT(Come_From_City__c)))</errorConditionFormula>
