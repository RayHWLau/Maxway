<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CloseLostReasonByAccountStatus</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
$RecordType.Name = &quot;Agent&quot;,
ISPICKVAL( Status_Sub_Agent__c, &quot;Close Lost&quot;), 
(ISBLANK( Closed_Lost_Reason__c )) 
)</errorConditionFormula>
    <errorMessage>Enter Closed Lost Reason</errorMessage>
</ValidationRule>
