<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ReasonMandatoryIfStatusUnsubscrib</fullName>
    <active>true</active>
    <description>Make the field  “Unsubscribed Reason”  mandatory if account status is “Unsubscribed”</description>
    <errorConditionFormula>AND($RecordType.Name = &quot;Agent&quot;, ISPICKVAL(  Status_Sub_Agent__c , &quot;Unsubscribed&quot;), 

  ISBLANK(  Unsubscribed_Reason__c )
  )</errorConditionFormula>
    <errorMessage>Please enter  Unsubscribed  Reason.</errorMessage>
</ValidationRule>
