<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RejectStageValidationVice</fullName>
    <active>true</active>
    <errorConditionFormula>AND (TEXT(Stage__c) != &apos;Reject&apos;,
      NOT(ISBLANK(TEXT( Rejected_By__c ))))</errorConditionFormula>
    <errorMessage>Please remove Rejected By Field.</errorMessage>
</ValidationRule>
