<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PendingStudentConformation</fullName>
    <active>true</active>
    <errorConditionFormula>AND (TEXT(Stage__c) = &apos;Pending Student Confirmation&apos;,
      ISBLANK(TEXT(  Offer__c )))</errorConditionFormula>
    <errorDisplayField>Offer__c</errorDisplayField>
    <errorMessage>Please fill offer first.</errorMessage>
</ValidationRule>
