<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>conditionalofferdepositamount</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    TEXT( Offer__c ) =&apos;Conditional&apos;, 
     Deposit_Amount__c =0
     )</errorConditionFormula>
    <errorDisplayField>Pre_application_Date__c</errorDisplayField>
    <errorMessage>If offer is &apos;Conditional&apos; , then deposit amount cannot be 0.</errorMessage>
</ValidationRule>
