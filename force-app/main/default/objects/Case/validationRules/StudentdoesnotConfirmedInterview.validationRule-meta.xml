<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>StudentdoesnotConfirmedInterview</fullName>
    <active>true</active>
    <errorConditionFormula>OR((TEXT(Student_Confirmed_Interview__c)=&apos;No&apos;&amp;&amp; ISBLANK(   Student_Counter_Propose_Date_Student_Lo__c )),
