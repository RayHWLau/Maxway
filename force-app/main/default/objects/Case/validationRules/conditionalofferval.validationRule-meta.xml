<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>conditionalofferval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    TEXT( Offer__c ) =&apos;Conditional&apos;, 
    ISBLANK(TEXT(Other_Conditions__c))
     )</errorConditionFormula>
    <errorMessage>If offer is &apos;Conditional&apos; , Please fill  Other Conditions.</errorMessage>
</ValidationRule>
