<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RejectStageValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND (TEXT(Stage__c) = &apos;Reject&apos;,
      ISBLANK(TEXT( Rejected_By__c )))</errorConditionFormula>
    <errorMessage>Please Fill Rejected By Field.</errorMessage>
</ValidationRule>
