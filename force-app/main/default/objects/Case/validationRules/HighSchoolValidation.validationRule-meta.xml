<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>HighSchoolValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(TEXT(School_Type__c)=&apos;High School&apos;,
     OR(ISBLANK( Housing__c),
        ISBLANK(TEXT(Intended_Grade__c))
        )
     )</errorConditionFormula>
    <errorMessage>If School type is &apos;High School&apos; please fill Housing and Intended Grade.</errorMessage>
</ValidationRule>
