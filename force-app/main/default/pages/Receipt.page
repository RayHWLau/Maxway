<apex:page cache="false" showHeader="false" action="{!init}" sidebar="false" standardController="Payment_Record__c" Extensions="PaymentRecordEx"
standardStylesheets="false" renderAs="{!IF($CurrentPage.Parameters.type='pdf', 'pdf', '')}">
<html>
    <head>
        <style type="text/css">
            h1 
            {
                text-align:center;
            }
            table.receipt
            {
                border-collapse: collapse;
                border:1px solid black;
                width:600px;
            }
            table.items
            {
                border-collapse: collapse;
                border:0px;
                width:700px;
            }

            table.items tr:first-of-type td
            {
                border-top: 0px;
            }

            table.items td:nth-child(odd){
                border-right:0px;
            }

            table.items td:nth-child(even){
                border-left:0px;
            }

            table.items td{
                width:25%;
            }

            td 
            {
                border:1px solid black;
            }
            body 
            {
                font-size: 10pt; 
                font-family:Verdana, Geneva, sans-serif;
            }

        </style>
    </head>
    <body>
        <apex:form >
        <table class="receipt">
            <tr>
                <td style="border-bottom:0px;"><apex:image style="width:40%;" value="{!$Resource.logo}"/></td>
            </tr>
            <tr>
                <td style="border-top:0px;font-size:30px;font-weight:bold;text-align:center;">Receipt</td>
            </tr>    
            <tr>
                <td style="scope:row;margin:0px;padding:0px;border:0px">
                    <table class="items">
                        <tr>
                            <td>Invoice Ref #:</td>
                            <td>{!Payment_Record__c.new_invoice_id__c}</td>
                            <td>Receipt Date :</td>
                            <td>
                                <apex:outputtext value="{0,date,dd/MM/yyyy}">
                                    <apex:param value="{!Payment_Record__c.Payment_Pay_in_Date__c}"/>
                                </apex:outputtext>
                            </td>
                        </tr>
                        <tr>
                            <td>Name:</td>
                            <td>{!Payment_Record__c.Opportunity__r.Account.Name}</td>
                            <td>Record ID :</td>
                            <td>{!Payment_Record__c.Record_ID__c}</td>
                        </tr>
                        <tr>
                            <td>Amt Rec :</td>
                            <td>{!Payment_Record__c.CurrencyIsoCode}
                                <apex:outputText value="{0, number, #,###.00}">
                                    <apex:param value="{!Payment_Record__c.Invoice_Amt__c}" />
                                </apex:outputText>
                            </td>
                            <td>Semester/Start Date :</td>
                            <td>{!IF(Payment_Record__c.Year__c == 'TBD' || Payment_Record__c.Term__c == 'TBD', 'TBD', Payment_Record__c.Year__c + ' ' + Payment_Record__c.Term__c)}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        <div class="ty-and-chop">
            <br/>
            <p style="font-size:20px;font-weight:bold;">Thank you.</p>
            <br/>
            <br/>
            <br/>
            <br/>
            <br/>
            <div style="border-bottom: 1px solid black; width: 200px;"></div>
            <p>Company Chop (not an official receipt without company chop)</p>
            <br/>
            <br/>
            <br/>
            <br/>
            <br/>
            <br/>
            <br/>
            <br/>
        </div>
        
        <table class="receipt">
            <tr>
                <td style="border-bottom:0px;"><apex:image style="width:40%;" value="{!$Resource.logo}"/></td>
            </tr>
            <tr>
                <td style="border-top:0px;font-size:30px;font-weight:bold;text-align:center;">Receipt</td>
            </tr>    
            <tr>
                <td style="scope:row;margin:0px;padding:0px;border:0px">
                    <table class="items">
                         <tr>
                            <td>Invoice Ref #:</td>
                            <td>{!Payment_Record__c.new_invoice_id__c}</td>
                            <td>Receipt Date :</td>
                            <td>
                                <apex:outputtext value="{0,date,dd/MM/yyyy}">
                                    <apex:param value="{!Payment_Record__c.Payment_Pay_in_Date__c}"/>
                                </apex:outputtext>
                            </td>
                        </tr>
                        <tr>
                            <td>Name:</td>
                            <td>{!Payment_Record__c.Opportunity__r.Account.Name}</td>
                            <td>Record ID :</td>
                            <td>{!Payment_Record__c.Record_ID__c}</td>
                        </tr>
                        <tr>
                            <td>Amt Rec :</td>
                            <td>{!Payment_Record__c.CurrencyIsoCode}
                                <apex:outputText value="{0, number, #,###.00}">
                                    <apex:param value="{!Payment_Record__c.Invoice_Amt__c}" />
                                </apex:outputText>
                            </td>
                            <td>Semester/Start Date :</td>
                            <td>{!IF(Payment_Record__c.Year__c == 'TBD' || Payment_Record__c.Term__c == 'TBD', 'TBD', Payment_Record__c.Year__c + ' ' + Payment_Record__c.Term__c)}</td>
                        </tr>
                        <tr>
                            <td>Country :</td>
                            <td>{!Payment_Record__c.Country__c}</td>
                            <td></td>
                            <td></td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        <br/>
        <br/>
        <br/>
        <p>For Maxway’s internal record</p>
        <br/>
        <br/>
        <br/>
        <br/>
        <br/>
        <apex:commandButton value="Save as Attachment" title="Attach" action="{!attachReceipt}" rendered="{!IF($CurrentPage.Parameters.type='pdf','false','true')}"/>
        </apex:form>
    </body>
</html>
</apex:page>