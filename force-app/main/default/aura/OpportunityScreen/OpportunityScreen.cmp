        <div class="slds-section slds-is-open" aura:id="opportunityId">
            <h3 class="slds-section__title">
                <button aria-controls="Filterlist" class="slds-button slds-section__title-action">
                    <span onclick="{!c.toggleSection}" data-auraId="opportunityId">
                        <lightning:icon iconName="utility:switch"
                                        size="x-small"
                                        class="slds-section__title-action-icon slds-button__icon_left"
                                        alternativeText="button icon" 
                                        />
                    </span>
                    <i> <span class="slds-truncate" title="Opportunity Info">Opportunity Information</span></i>
                </button>
            </h3>
            
            <div class="slds-section__content" id="opportunityId">
                
                <div class ="slds-m-horizontal_small slds-m-top_small" >
                    <button  class="slds-button slds-section__title-action">
                        <i> <span class="slds-truncate" title="Basic Information">Client Preferences</span></i>
                    </button>
                </div>
                
                <!--                                                  Client Preferences  ROW  1  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="opp" type="text" name="Opportunity Name" label="Opportunity Name" required="true"  value="{!v.opportunity.Name}" disabled="{!v.opportunity.StageName =='Closed Lost'}" />    
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input  aura:id="opp"  name="Stage" label="Stage"  value="{!v.opportunity.StageName}"  disabled="true" />  
                        
                    </div>
                    
                </div>
                <!--                                                  Client Preferences  ROW  2  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="opp" type="date" name="Intended Study Abroad Date" value="{!v.opportunity.Intended_Go_Abroad_Date__c}" label="Intended Go Abroad Date" required="true"  disabled="{!v.opportunity.StageName =='Closed Lost'}"  />    
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        
                        <lightning:input aura:id="opp"  name="Follow Up Situation" label="Follow Up Situation"  value="{!v.opportunity.Follow_Up_Situation__c}"   disabled="true" /> 
                        
                    </div>
                    
                </div>
                
                <!--                                                  Client Preferences  ROW  3  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">
                          <aura:if isTrue="{!v.isportal}">
                        <lightning:dualListbox aura:id="opp"
                                               name="Country"
                                               label="Preferred Country"
                                               sourceLabel="Available Country"
                                               selectedLabel="Selected Country"
                                               options="{!v.opportunitycountry }"
                                               value="{!v.selectedCountry}"
                                               disabled="{!v.opportunity.StageName =='Closed Lost'}" /> 
                        </aura:if>
                        
                        <!-- Added on 18 may 2020 as Maxway will see different Fields -->
                        <aura:if isTrue="{!!v.isportal}">
                        
                            
                            <lightning:dualListbox aura:id="opp"
                                                   name="Country"
                                                   label="Preferred Country"
                                                   sourceLabel="Available Country"
                                                   selectedLabel="Selected Country"
                                                   options="{!v.prefferedCountrylist }"
                                                   value="{!v.selectedCountryOps}"
                                                   disabled="{!v.opportunity.StageName =='Closed Lost'}" /> 
                        </aura:if>
                        <!-- Added on 18 may 2020 as Maxway will see different Fields -->
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:dualListbox aura:id="opp"
                                               name="Close Lost Reason"
                                               label="Close Lost Reason"
                                               sourceLabel="Available Close Lost Reason"
                                               selectedLabel="Selected Close Lost Reason"
                                               options="{!v.ClosedLostReasonlist }"
                                               value="{!v.selectedcloselostreason}"
                                               disabled="{!or(v.oppId==null,v.opportunity.StageName =='Closed Lost')}"
                                               onchange="{!c.closelostaction}"/>
                    </div>
                    
                </div>
                
                <!--                                                  Client Preferences  ROW  4  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">
                         
                        <aura:if isTrue="{!v.isportal}">
                            
                            <lightning:input type="text" aura:id="opp" name="State" label="State" value="{!v.opportunity.State__c}"  disabled="{!v.opportunity.StageName =='Closed Lost'}"   /> 
                            
                        </aura:if>
                        
                        <!-- Added on 18 may 2020 as Maxway will see different Fields -->
                        <aura:if isTrue="{!!v.isportal}">
                        
                            <lightning:dualListbox aura:id="opp"
                                               name="State"
                                               label="Preferred State"
                                               options="{!v.prefferedStatelist }"
                                               value="{!v.selectedStateOps}"
                                                   disabled="{!v.opportunity.StageName =='Closed Lost'}" 
                                               /> 
                        
                        </aura:if>
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input type="text" aura:id="opp" name="Close Lost Reason Others" label="Close Lost Reason Others" value="{!v.opportunity.Closed_Lost_Description__c}"  disabled="{!or(v.oppId==null,v.opportunity.StageName =='Closed Lost')}"  onchange="{!c.closelostaction}"  /> 
                        
                        
                    </div>
                    
                </div>
                <!--                                                  Client Preferences  ROW  5  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">
                        
                          
                        <aura:if isTrue="{!v.isportal}">
                        <lightning:input type="text" aura:id="opp" name="City" label="City" value="{!v.opportunity.City__c}"  disabled="{!v.opportunity.StageName =='Closed Lost'}"   /> 
                        </aura:if>
                        
                         <!-- Added on 18 may 2020 as Maxway will see different Fields -->
                        <aura:if isTrue="{!!v.isportal}">
                        
                            <lightning:dualListbox aura:id="opp"
                                               name="City"
                                               label="Preferred City"
                                               options="{!v.prefferedCitylist }"
                                               value="{!v.selectedCityOps}"
                                               disabled="{!v.opportunity.StageName =='Closed Lost'}" 
                                               /> 
                        
                        </aura:if>
                        
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:dualListbox aura:id="opp"
                                               name="School Type"
                                               label="School Type"
                                               sourceLabel="Available School Type"
                                               selectedLabel="Selected School Type"
                                               options="{!v.PreferredSchoolTypelist }"
                                               value="{!v.selectedschooltype}"
                                               disabled="{!v.opportunity.StageName =='Closed Lost'}"
                                               onchange="{!c.schooltypechange}" />     
                        
                    </div>
                    
                </div>
                
                <!--                                                  Client Preferences  ROW  6  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:dualListbox aura:id="opp"
                                               name="Housing Option"
                                               label="For High School: Housing Option"
                                               sourceLabel="Available Housing Option"
                                               selectedLabel="Selected Housing Option"
                                               options="{!v.HousingOptionlist }"
                                               value="{!v.selectedHousing}"
                                               disabled="{!or(or(v.opportunity.StageName =='Closed Lost',v.selectedschooltype.length==0),v.schooltype!='High School')}" />
                        
                    </div>
                    
                     <div class="slds-col slds-size_1-of-2"> 
                        <lightning:dualListbox aura:id="opp"
                                               name="Major category"
                                               label="For College or University: Major"
                                               sourceLabel="Available Major category"
                                               selectedLabel="Selected Major category"
                                               options="{!v.ForCCorUniversityPreferredMajorlist }"
                                               value="{!v.selectedmajor}"
                                               disabled="{!or(or(v.opportunity.StageName =='Closed Lost',v.selectedschooltype.length==0),v.schooltype=='High School')}" />
                        
                        
                    </div>
                    
                
                </div>
                <!-- div class ="slds-m-horizontal_small slds-m-top_small" >
                    <button  class="slds-button slds-section__title-action">
                        <i> <span class="slds-truncate" title="Basic Information">High School</span></i>
                    </button>
                </div>
                <div class ="slds-m-horizontal_small slds-m-top_small" >
                    <button  class="slds-button slds-section__title-action">
                        <i> <span class="slds-truncate" title="College/University">College/University</span></i>
                    </button>
                </div -->
                
                <!--                                                  Client Preferences  ROW  7  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                   
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="opp"  name="Specific Major" label="Specific Major"   value="{!v.opportunity.Specific_Major__c}" disabled="{!or(or(v.opportunity.StageName =='Closed Lost',v.selectedschooltype.length==0),v.schooltype=='High School')}" />  
                    </div>
                    <div class="slds-col slds-size_1-of-2">  
                        <lightning:textarea  aura:id="opp" name="Description" label="Description" value="{!v.opportunity.Description}"  disabled="{!v.opportunity.StageName =='Closed Lost'}" />    
                    </div>
                </div>
                
                
                <aura:if isTrue="false">
                    <!-- ##########################        Not in used  #####################################-->
                    <div class="slds-grid slds-gutters slds-m-horizontal_small">
                        <div class="slds-col slds-size_1-of-2">  
                            <lightning:input aura:id="opp" type="text" name="Annual Budget" label="Annual Budget"    value="{!v.opportunity.Annual_Budgetnew__c}" disabled="{!v.opportunity.StageName =='Closed Lost'}" /> 
                        </div>
                        <div class="slds-col slds-size_1-of-2">
                            <lightning:select aura:id="opp"  name="Currency" label="Currency" required="true" value="{!v.opportunity.CurrencyIsoCode}"  > 
                                <option value="">--None--</option>
                                <aura:iteration items="{!v.currencylist}" var="val">
                                    <option value="{!val}">{!val}</option>
                                </aura:iteration>
                            </lightning:select> 
                        </div>
                    </div>
                    <!-- ##########################        Not in used  #####################################-->
                </aura:if>
                
            </div><!-- section content closed opportunityId -->
            
        </div><!-- Sction closed ParentContactId -->
    </div><!-- slds modal closed -->
    
    <div class="slds-m-vertical_small"/>
    
    <div class="slds-clearfix">
        <div class="slds-float_right">
            <lightning:button variant="Brand" label="Save" title="Save" onclick="{!c.handleSave}"/>
            <lightning:button variant="Neutral" label="Cancel" title="Cancel" onclick="{!c.closemodal}" />
        </div>
    </div>
    
</aura:component>