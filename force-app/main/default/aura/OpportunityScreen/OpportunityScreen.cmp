<aura:component implements="force:appHostable,force:lightningQuickActionwithoutheader,forceCommunity:availableForAllPageTypes" access="global" controller="OpportunityCustomScreenAura" >
    
    <aura:attribute name="opportunity" type="Opportunity" default="{ 'sobjectType': 'Opportunity' }"/>
    <aura:attribute name="account" type="Account" default="{ 'sobjectType': 'Account' }"/>
    <aura:attribute name="Contact1" type="Contact" default="{ 'sobjectType': 'Contact' }"/>
    <aura:attribute name="Contact2" type="Contact" default="{ 'sobjectType': 'Contact' }"/>
    <aura:attribute name ="recordtypeid" type="string" />
    <aura:attribute name ="EmailValidation" type="integer" default="0"/>
    <aura:attribute name ="recordtypename" type="string" />
    <aura:attribute name ="selectedcloselostreason" type="list"  />
    <aura:attribute name ="selectedacccloselostreason" type="list"  />
    <aura:attribute name ="selectedHousing" type="list"  />
    <aura:attribute name ="selectedschooltype" type="list"  />
    <aura:attribute name ="selectedmajor" type="list"  />
    <aura:attribute name ="selectedCountry" type="list"  />
    <aura:attribute name ="opportunitycountry" type="list" />
    <aura:attribute name ="HousingOptionlist" type="list" />
    <aura:attribute name ="ForCCorUniversityPreferredMajorlist" type="list" />
    <aura:attribute name ="ForCCorUniversitylist" type="list" />
    <aura:attribute name ="ForHSPreferredProgramlist" type="list" />
    <aura:attribute name ="PreferredSchoolTypelist" type="list" />
    <aura:attribute name ="FollowUpSituationlist" type="list" />
    <aura:attribute name ="ClosedLostReasonlist" type="list" default="[]" />
    <aura:attribute name ="StageNamelist" type="list" />
    <aura:attribute name ="Relationshiplist" type="list" />
    <aura:attribute name ="salutationlist" type="list" />
    <aura:attribute name ="studentstatuslist" type="list" />
    <aura:attribute name ="closeAccountreasonlist" type="list" />
    <aura:attribute name ="SourceOfReferrallist" type="list" />
    <aura:attribute name ="countryCodelist" type="list" />
    <aura:attribute name ="consocialmedialist" type="list" />
    <aura:attribute name ="accsocialmedialist" type="list" />
    <aura:attribute name ="nationalitylist" type="list" />
    <aura:attribute name ="levelofeducationlist" type="list" />
    <aura:attribute name ="educationSystem" type="list" />
    <aura:attribute name ="studentatwhatyearlist" type="list" />
    <aura:attribute name ="startofacedmicyearlist" type="list" />
    <aura:attribute name ="totalyearofeduationlist" type="list" />
    <aura:attribute name ="oppId" type="string" />
    <aura:attribute name="CountryWithStateMap" type="Map" />
    <aura:attribute name="StateWithCityMap" type="Map" />
    <aura:attribute name ="countrylist" type="list" />
    <aura:attribute name ="statelist" type="list" />
    <aura:attribute name ="citylist" type="list" />
    <aura:attribute name ="genderlist" type="list" />
    <aura:attribute name ="accRelationshiplist" type="list" />
    <aura:attribute name ="accedmlist" type="list" />
    <aura:attribute name ="accwechatsourcelist" type="list" />
    <aura:attribute name ="accConfirmedclientinCompanysocialmedialist" type="list" />
    <aura:attribute name ="conwechatsourcelist" type="list" />
    <aura:attribute name ="conConfirmedclientinCompanysocialmedialist" type="list" />
    <aura:attribute name ="accdataoriginlist" type="list" />
    <aura:attribute name ="showspinner" type="boolean" default="true" />
    <aura:attribute name ="showbutton" type="boolean" default="true" />
    <aura:attribute name ="cancloselost" type="boolean" default="false" />
    <aura:attribute name ="showstatecity" type="boolean" default="false" />
    <aura:attribute name ="isportal" type="boolean"  />
    <aura:attribute name ="header" type="string" />
    <aura:attribute name ="schooltype" type="string"  />
    <aura:attribute name="currencylist" type="list" />
    <aura:attribute name="counVal" type="string"/>
    <aura:handler name = "init" value = "{!this}" action = "{!c.doinit}" />
     <!-- By Ravi on 3rd sept-->
    <aura:attribute name ="isOrignalChange" type="boolean" />
    <!--/ -->
    <!-- Added on 18 may 2020 -->
    <aura:attribute name ="prefferedCountrylist" type="list" />
    <aura:attribute name ="selectedCountryOps" type="list" />
    <aura:attribute name ="prefferedStatelist" type="list" />
    <aura:attribute name ="selectedStateOps" type="list" />
    <aura:attribute name ="prefferedCitylist" type="list" />
    <aura:attribute name ="selectedCityOps" type="list" />
    
    <!--END 18 may 2020 -->
    
    <aura:handler name="change" value="{!v.account.Account_Manager__c}" action="{!c.Onaccountmangerchange}"/>
    <aura:handler name="change" value="{!v.account.Original_Grade_Mapping__c}" action="{!c.OnOriginalgradechange}"/>
    
    
    <aura:if isTrue="{!v.showspinner}">
        <lightning:spinner name="spinner" size="medium" variant="brand" />
    </aura:if>
    
    <div class="slds-text-heading_medium slds-text-align_center slds-m-bottom_small">{!v.header}</div>
    <div class="slds-col modal-body slds-scrollable_y slds-border_bottom slds-border_top" style="height:55vh;">
        <div class="slds-section slds-is-open" aura:id="StudentId">
            <h3 class="slds-section__title">
                <button aria-controls="Filterlist" class="slds-button slds-section__title-action">
                    <span onclick="{!c.toggleSection}" data-auraId="StudentId">
                        <lightning:icon iconName="utility:switch"
                                        size="x-small"
                                        class="slds-section__title-action-icon slds-button__icon_left"
                                        alternativeText="button icon" 
                                        />
                    </span>
                    <i> <span class="slds-truncate" title="Company Info">Student Information</span></i>
                </button>
            </h3>
            <!-- ##################################################  Personal Information  ############################################# -->
            <div class="slds-section__content" id="StudentId">
                
                <div class ="slds-m-horizontal_small" >
                    <button  class="slds-button slds-section__title-action">
                        <i> <span class="slds-truncate" title="Basic Information">Personal Information</span></i><!-- Basic Information-->
                    </button>
                </div>
                
                 <!--                                          Personal Information  ROW  1  															-->
              	<div class="slds-grid slds-gutters slds-m-horizontal_small">
               
                     <div class="slds-col slds-size_1-of-2">
                        <lightning:select aura:id="acc"  name="salutation" label="Salutation"  required="true" value="{!v.account.Salutation}" > 
                            <option value="">--None--</option>
                            <aura:iteration items="{!v.salutationlist}" var="val">
                                <option value="{!val}">{!val}</option>
                            </aura:iteration>
                        </lightning:select>  
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="acc" type="text" name="Last Name" label="Last Name" required="true" value="{!v.account.LastName}"  />  
                    </div>
                
                </div>
                
                 <!--                                          Personal Information  ROW  2 															-->
              	<div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        
                        <c:Lookup aura:id="acc" label="Account Manager" object="Staff__c" searchField="Name" 
                                  iconName="custom:custom27" order="Name"
                                  limit="10" required="true" loadingMessage="Loading..." errorMessage="Invalid input" value="{!v.account.Account_Manager__c}" />
                    </div>
                    
                     <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="acc" type="text" name="First Name" label="First Name"  value="{!v.account.FirstName}" /> 
                    </div>
                
                </div>
                
                 <!--                                          Personal Information  ROW  3															-->
              	<div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2"> 
                        <lightning:select  aura:id="acc"  name="Source Of Referral" label="Source Of Referral"  required="true" value="{!v.account.Source_Of_Referral__c}" > 
                            <option value="">--None--</option>
                            <aura:iteration items="{!v.SourceOfReferrallist}" var="val">
                                <option value="{!val}">{!val}</option>
                            </aura:iteration>
                        </lightning:select>  
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="acc" type="text" name="Source Of Referral Others" label="Source Of Referral Others"  value="{!v.account.Source_Of_Referral_Others__c}" />  
                    </div>
                
                </div>
                 <!--                                          Personal Information  ROW  4															-->
              	<div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        <aura:if isTrue="{!!v.isportal}">
                            <lightning:select aura:id="acc" required="true" name="Data Origin" label="Data Origin"  value="{!v.account.Data_Origin__c}"  > 
                                <option value="">--None--</option>
                                <aura:iteration items="{!v.accdataoriginlist}" var="val">
                                    <option value="{!val}">{!val}</option>
                                </aura:iteration>
                            </lightning:select>
                            
                        </aura:if>
                        <!-- added on 18 may 2020 NTF 666 as to add Country residing for the Portal user Only. --> 
                        <aura:if isTrue="{!v.isportal}">
                            <lightning:select aura:id="acc"  name="Country Residing" label="Country Residing"  required="true" value="{!v.account.Country_Residing__c}" onchange="{!c.OnChangeValueOfCountry}" > 
                                
                                <aura:iteration items="{!v.countrylist}" var="val">
                                    <option value="{!val.value}">{!val.label}</option>
                                </aura:iteration>
                            </lightning:select> 
                        </aura:if>
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                         <aura:if isTrue="{!!v.isportal}">
                        <aura:if isTrue="{!v.showstatecity}">
                            <lightning:select aura:id="acc"  name="Come From Province" label="Come From Province"  value="{!v.account.Come_From_Province__c}" onchange="{!c.OnChangeValueOfstate}" disabled="{!!v.statelist.length>0}" > 
                                <option value="">--None--</option>
                                <aura:iteration items="{!v.statelist}" var="val">
                                    <option value="{!val.value}" selected="{!val.value == v.account.Come_From_Province__c}" >{!val.label}</option>
                                </aura:iteration>
                            </lightning:select> 
                            <aura:set attribute="else">
                                <lightning:input aura:id="acc"  name="Come From Province" label="Come From Province"  value="{!v.account.Come_From_Province__c}"  disabled="true" />
                            </aura:set>
                        </aura:if>
                             <aura:set attribute="else">
                                <lightning:input aura:id="acc"  name="Province/State" label="Province/State"  value="{!v.account.Province__c}"   />
                            </aura:set>
                        </aura:if>
                    </div>
                
                </div>
                 <!--                                          Personal Information  ROW  5															-->
              	<div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        <aura:if isTrue="{!!v.isportal}">
                        <aura:if isTrue="{!v.showstatecity}">
                            <lightning:select aura:id="acc"  name="Come From CityP" label="Come From City"  value="{!v.account.Come_From_City__c}" disabled="{!!v.citylist.length>0}" > 
                                <option value="">--None--</option>
                                <aura:iteration items="{!v.citylist}" var="val">
                                    <option value="{!val.value}" selected="{!val.value == v.account.Come_From_City__c}">{!val.label}</option>
                                </aura:iteration>
                            </lightning:select>
                            <aura:set attribute="else">
                                <lightning:input aura:id="acc"  name="Come From City" label="Come From City"  value="{!v.account.Come_From_City__c}"  disabled="true" />
                            </aura:set>
                        </aura:if>
                        <aura:set attribute="else">
                                <lightning:input aura:id="acc"  name="City" label="City"  value="{!v.account.City__c}"   />
                            </aura:set>
                        </aura:if> 
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:select  aura:id="acc" name="Nationality" label="Nationality"  required="true"   value="{!v.account.Nationality__c}"> 
                            <option value="">--None--</option>
                            <aura:iteration items="{!v.nationalitylist}" var="val">
                                <option value="{!val}">{!val}</option>
                            </aura:iteration>
                        </lightning:select>   
                    </div>
                
                </div>
                
                 <!--                                          Personal Information  ROW  6															-->
              	<div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="acc" type="Date" name="Date Of Birth" label="Date Of Birth" value="{!v.account.Date_of_Birth__c}"  />  <!--PersonBirthdate-->
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:select aura:id="acc"  name="Gender" label="Gender" value="{!v.account.Gender__c}"  > 
                            <option value="">--None--</option>
                            <aura:iteration items="{!v.genderlist}" var="val">
                                <option value="{!val}">{!val}</option>
                            </aura:iteration>
                        </lightning:select>
                        
                    </div>
                
                </div>
                                
                <!-- class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:select  aura:id="acc" name="Student Status" label="Student Status"   value="{!v.account.Student_Status__c}" onchange="{!c.accStatusChange}" disabled="{!v.account.Student_Status__c=='Don\'t Contact'}"> 
                            <aura:iteration items="{!v.studentstatuslist}" var="val">
                                <option value="{!val}">{!val}</option>
                            </aura:iteration>
                        </lightning:select>  
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input type="text" name="Recordtype" label="Recordtype" readonly="true" value="{!v.recordtypename}" />
                    </div>
                    
                </div -->
                
                <!-- class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:dualListbox aura:id="acc"
                                               name="Don't Contact Reason"
                                               label="Don't Contact Reason"
                                               sourceLabel="Available Don't Contact Reason"
                                               selectedLabel="Selected Don't Contact Reason"
                                               options="{!v.closeAccountreasonlist }"
                                               value="{!v.selectedacccloselostreason}"
                                               disabled="true"/>
                        
                    </div>
                </div -->  
                <!-- class="slds-grid slds-gutters slds-m-horizontal_small">
                    
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="acc"  name="Don't Contact Reason Others" label="Don't Contact Reason Others"  value="{!v.account.Dont_Contact_Reason_Others__c}" disabled="true" />   
                    </div>
                    
                </div-->
                <!-- div class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:select aura:id="acc"  name="Country Residing" label="Country Residing"  required="true" value="{!v.account.Country_Residing__c}" onchange="{!c.OnChangeValueOfCountry}" > 
                            
                            <aura:iteration items="{!v.countrylist}" var="val">
                                <option value="{!val.value}">{!val.label}</option>
                            </aura:iteration>
                        </lightning:select> 
                    </div>
                    
                    
                    
                </div -->
                <!--div class ="slds-m-horizontal_small slds-m-top_small" >
                    <button  class="slds-button slds-section__title-action">
                        <i> <span class="slds-truncate" title="Basic Information">Personal Information</span></i>
                    </button>
                </div  -->
                <!-- div class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">
                        <aura:if isTrue="{!!v.isportal}">
                            <lightning:select aura:id="acc"  name="eDM" label="eDM" value="{!v.account.eDM__c}"  > 
                                
                                <aura:iteration items="{!v.accedmlist}" var="val">
                                    <option value="{!val}">{!val}</option>
                                </aura:iteration>
                            </lightning:select>
                        </aura:if>
                    </div>
                </div-->
                
                <!--  ###############################################  Account Contact  ##############################################################  -->
                <div class ="slds-m-horizontal_small slds-m-top_small" >
                    <button  class="slds-button slds-section__title-action">
                        <i> <span class="slds-truncate" title="Contact">Account Contact</span></i><!-- Contact -->
                    </button>
                </div>
                
                <!--                                                  Account Contact  ROW    1  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:select aura:id="acc"  name="Country Code" label="Country Code" value="{!v.account.Country_Code__c}"  > 
                            <option value="">--None--</option>
                            <aura:iteration items="{!v.countryCodelist}" var="val">
                                <option value="{!val}">{!val}</option>
                            </aura:iteration>
                        </lightning:select>  
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="acc" type="text" name="validation" label="Mobile" value="{!v.account.Mobile__c}"  />  
                    </div>
                </div>
                
                <!--                                                  Account Contact  ROW    2  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:select aura:id="acc"  name="validation" label="Social Media" value="{!v.account.Social_Media__pc}"  > 
                            <option value="">--None--</option>
                            <aura:iteration items="{!v.accsocialmedialist}" var="val">
                                <option value="{!val}">{!val}</option>
                            </aura:iteration>
                        </lightning:select>     
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="acc" type="text" name="validation" label="Social Media Others" value="{!v.account.Social_Media_Others__c}"  />  
                    </div>
                    
                </div>
                
                <!--                                                  Account Contact  ROW    3  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                     <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="acc" type="text" name="validation" label="Social Media Account" value="{!v.account.WeChat_ID__pc}"  />  
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="acc" type="email" name="validation" label="Email"  value="{!v.account.PersonEmail}"  />
                        
                    </div>
                    
                </div>
                
                <!--                                                  Account Contact  ROW    4  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    
                    <div class="slds-col slds-size_1-of-2">
                        <aura:if isTrue="{!!v.isportal}">
                            <lightning:select aura:id="acc"  name="WeChat Source" label="WeChat Source" value="{!v.account.WeChat_Source__pc}"  > 
                                <option value="">--None--</option>
                                <aura:iteration items="{!v.accwechatsourcelist}" var="val">
                                    <option value="{!val}">{!val}</option>
                                </aura:iteration>
                            </lightning:select>   
                        </aura:if>
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2 slds-m-top_large">
                        
                        <lightning:input aura:id="acc" type="checkbox" name="Add client to Company social media." label="Add Client to Company Social Media Account." checked="{!v.account.Add_client_to_Company_social_media__c}" /><!-- value="{!v.account.Add_client_to_Company_social_media__c}" -->    
                    </div>
                    
                </div>
                
                <!--  ###############################################  Educational Qualification  ##############################################################  -->
                <div class ="slds-m-horizontal_small slds-m-top_small" >
                    <button  class="slds-button slds-section__title-action">
                        <i> <span class="slds-truncate" title="Basic Information">Educational Qualification</span></i>
                    </button>
                </div>
                
               <!--                                                  Educational Qualification  ROW   1  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                      <lightning:select aura:id="acc"  name="Education System" label="Education System" required ="true" value="{!v.account.Education_System__c}"  onchange="{! c.getEdu}"> 
                          <option value="">--None--</option>
                          <aura:iteration items="{!v.educationSystem}" var="val">
                              <option value="{!val}">{!val}</option>
                          </aura:iteration>
                      </lightning:select>   
                  </div>
                    
                     <div class="slds-col slds-size_1-of-2 ">
                        <lightning:select aura:id="acc"  name="Start of academic year" label="School Start Month" required ="true" value="{!v.account.Start_of_Academic_Month__c}"  > 
                            <option value="">--None--</option>
                            <aura:iteration items="{!v.startofacedmicyearlist}" var="val">
                                <option value="{!val}">{!val}</option>
                            </aura:iteration>
                        </lightning:select>    
                    </div>
                
                </div>
               
                <!--                                                  Educational Qualification  ROW   2  															-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        <aura:renderIf isTrue="{!v.opportunity.Id==null}">
                        <c:strike_lookup 
                                         label="Original Grade"
                                         object="Grade_Mapping__c"
                                         searchField="Name"
                                         placeholder="Select an option"
                                         iconName="standard:account"
                                         value="{!v.account.Original_Grade_Mapping__c}"
                                         filter="{!'Country__c='+'\''+v.counVal+'\''}"
                                         order="Name"
                                         aura:id="acc"
                                         showRecentRecords = "true"
                                         loadingMessage="Loading..."
                                         errorMessage="Invalid input"/>
                        <!-- c:Lookup aura:id="acc" label="Initial Grade" object="Grade_Mapping__c" searchField="Name" 
                                  iconName="custom:custom27" order="Name"
                                  limit="10" required="true" loadingMessage="Loading..." errorMessage="Invalid input" 
                                  value="{!v.account.Original_Grade_Mapping__c}" / --> 
                        </aura:renderIf>
                    </div>
                    
                     <div class="slds-col slds-size_1-of-2">
                        <lightning:input type="Date" aura:id="acc" name="Expected Graduation Date" label="Expected Graduation Date" required="true" value="{!v.account.Expected_Graduation_Date__c}"  />  
                    </div>
                    
                </div>
                
                <!--div class="slds-grid slds-gutters slds-m-horizontal_small" -->
                    
                    <!-- div class="slds-col slds-size_1-of-2 ">
                        
                        <c:Lookup aura:id="acc" label="Current Grade" object="Grade_Mapping__c" searchField="Name" 
                                  iconName="custom:custom27" order="Name"
                                  limit="10" required="true" loadingMessage="Loading..." errorMessage="Invalid input" value="{!v.account.Current_Grade_Mapping__c}" disabled ="true" />   
                    </div -->
                   
                    <!-- div class="slds-col slds-size_1-of-2">
                        <lightning:select aura:id="acc"  name="Level of Education" label="Level of Education" required ="true" value="{!v.account.Level_of_Education__c}"  > 
                            <option value="">None</option>
                            <aura:iteration items="{!v.levelofeducationlist}" var="val">
                                <option value="{!val}">{!val}</option>
                            </aura:iteration>
                        </lightning:select>   
                    </div -->
                    
                    <!-- div class="slds-col slds-size_1-of-2 ">
                        <lightning:select aura:id="acc"  name="Total Years of Education" label="Total Years of Education" required="true" value="{!v.account.Total_Years_of_Education__c}"  > 
                            <option value="">None</option>
                            <aura:iteration items="{!v.totalyearofeduationlist}" var="val">
