        <div class="slds-section slds-is-open" aura:id="opportunityId">
            <h3 class="slds-section__title">
                <button aria-controls="Filterlist" class="slds-button slds-section__title-action">
                    <span onclick="{!c.toggleSection}" data-auraId="opportunityId">
                        <lightning:icon iconName="utility:switch"
                                        size="x-small"
                                        class="slds-section__title-action-icon slds-button__icon_left"
                                        alternativeText="button icon" 
                                        />
                    </span>
                    <i> <span class="slds-truncate" title="Opportunity Info">Opportunity Information</span></i>
                </button>
            </h3>
            
            <div class="slds-section__content" id="opportunityId">
                
                <!--div class ="slds-m-horizontal_small slds-m-top_small" >
                    <button  class="slds-button slds-section__title-action">
                        <i> <span class="slds-truncate" title="Basic Information">Basic Information</span></i>
                    </button>
                </div -->
                
                <!--                                       ROW  1  													-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="opp" type="text" name="Opportunity Name" label="Opportunity Name" readonly="true"  value="{!v.opportunity.Name}" />    
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        
                        <lightning:input aura:id="opp"  name="Stage" label="Stage"  value="{!v.opportunity.StageName}"  readonly="true" /> 
                        
                    </div>
                    
                </div>
                
                <!--                                       ROW  2  													-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    
                    <div class="slds-col slds-size_1-of-2">
                        
                        <lightning:input aura:id="opp" type="text" name="Opportunity Name" label="Account Name" readonly="true"  value="{!v.account.Name}" />    
                        
                    </div>
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="opp" type="text" name="Opportunity Name" label="Opportunity Case Manager" readonly="true"  value="{!v.opportunity.Case_Manager_Namefor__c}" />   
                        
                    </div>
                    
                    
                </div>
                
                <!--                                       ROW  3  													-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="opp" type="date" name="Intended Go Abroad Date" value="{!v.opportunity.Intended_Go_Abroad_Date__c}" label="Intended Study Abroad Date" readonly="true" />    
                    </div>
                    <div class="slds-col slds-size_1-of-2">
                        
                        <lightning:input aura:id="opp"  name="Follow Up Situation" label="Follow Up Situation"  value="{!v.opportunity.Follow_Up_Situation__c}"  readonly="true" /> 
                        
                    </div>
                    
                </div>
                
                <!--                                       ROW  4  													-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                	 <aura:if isTrue="{!v.isportal}">
                    <div class="slds-col slds-size_1-of-2">
                      <lightning:input  aura:id="opp" name="Country" label="Preferred Country" value="{!v.opportunity.Preferred_Countrynew__c}" readonly="true" />    
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                     <lightning:input aura:id="opp"  name="State" label="State" value="{!v.opportunity.State__c}" readonly="true" />   
                    </div>
                    </aura:if>
                     <!-- Added on 18 may 2020 as Maxway will see different Fields -->
                    <aura:if isTrue="{!!v.isportal}">
                        
                        <div class="slds-col slds-size_1-of-2">
                            <lightning:input  aura:id="opp" name="Country" label="Preferred Country" value="{!v.opportunity.Preferred_Country__c}" readonly="true" />    
                        </div>
                        
                        <div class="slds-col slds-size_1-of-2">
                            <lightning:input aura:id="opp"  name="State" label="Preferred State" value="{!v.opportunity.Preferred_State__c}" readonly="true" />   
                        </div>
                        
                    </aura:if>
                    
                </div>
                
                <!--                                       ROW  5  													-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    
                    <aura:if isTrue="{!v.isportal}">
                        <div class="slds-col slds-size_1-of-2">
                            <lightning:input aura:id="opp"  name="City" label="City" value="{!v.opportunity.City__c}" readonly="true" />
                        </div>
                    </aura:if>
                    
                    <aura:if isTrue="{!!v.isportal}">
                        
                        <div class="slds-col slds-size_1-of-2">
                            <lightning:input aura:id="opp"  name="City" label="Preferred City" value="{!v.opportunity.Preferred_City__c}" readonly="true" />
                        </div>
                        
                    </aura:if>
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input aura:id="opp"  name="School Type" label="School Type" value="{!v.opportunity.Preferred_School_Type__c}" readonly="true" />    
                        
                    </div>
                    
                </div>
                
                <!--                                       ROW  6  													-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                      <lightning:input aura:id="opp"  name="Housing Option" label="For High School: Housing Option" value="{!v.opportunity.Housing_Option__c}" readonly="true" />  
                        
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2"> 
                     <lightning:input aura:id="opp"  name="Major category" label="For College or University: Major" value="{!v.opportunity.For_CC_or_University_Preferred_Major__c}"  readonly="true" />   
                        
                    </div>
                    
                </div>
                
                <!--                                       ROW  7  													-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                       <lightning:input aura:id="opp"  name="Specific Major" label="Specific Major" value="{!v.opportunity.Specific_Major__c}"  readonly="true" />  
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input  aura:id="opp" name="Close Lost Reason" label="Close Lost Reason" value="{!v.opportunity.Closed_Lost_Reason__c}" readonly="true" /> 
                        
                    </div>
                    
                </div>
                
                <!--                                       ROW  8  													-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                
                    <div class="slds-col slds-size_1-of-2">
                        <lightning:input type="text" aura:id="opp" name="Close Lost Reason Others" label="Close Lost Reason Others" value="{!v.opportunity.Closed_Lost_Description__c}"  readonly="true" />     
                        
                    </div>
                   <div class="slds-col slds-size_1-of-2">
                        <lightning:input  aura:id="opp" type="date" name="Close Date" label="Close Date" readonly="true" value="{!v.opportunity.CloseDate}"  />    
                    </div>
                
                    
                </div>
                
                <!--                                       ROW  9  													-->
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    
                    <div class="slds-col slds-size_1-of-2">  
                        <lightning:textarea  aura:id="opp" name="Description" label="Description" value="{!v.opportunity.Description}" disabled="true" />    
                    </div>
                    
                </div>
                
                
