                </div>
                
                <div class="slds-grid slds-gutters slds-m-horizontal_small">
                    <div class="slds-col slds-size_1-of-2">  
                        
                        <lightning:input aura:id="opp"  name="Annual Budget" label="Annual Budget"  value="{!v.opportunity.Annual_Budgetnew__c}" readonly="true" /> 
                        
                    </div>
                    
                    <div class="slds-col slds-size_1-of-2">
                       
                       <lightning:input aura:id="opp"  name="Currency" label="Currency"  value="{!v.opportunity.CurrencyIsoCode}" readonly="true" /> 
                    </div>
                    
                </div -->
                
                
            </div>
            
        </div>
    
</aura:component>