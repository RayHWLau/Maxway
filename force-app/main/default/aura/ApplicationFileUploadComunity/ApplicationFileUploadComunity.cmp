<aura:component implements="forceCommunity:availableForAllPageTypes,force:hasRecordId" access="global" controller="docUpload">
    <aura:attribute name="documentList" type="Map" default="{}"/> 
    <aura:attribute name="discriptionmap" type="Map" default="{}"/>
    <aura:attribute name="iteratorList" type="List" />    
    <aura:attribute name="uploadList" type="List" />  
    <aura:attribute name="doclink" type="boolean" default="false" />
    <aura:attribute name="ismaxway" type="boolean"  />
    <aura:attribute name ="docidmap" type ="List" />    
    <aura:attribute name="errorMsg" type="String" default="" />
    <aura:attribute name="discription" type="String" default="" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="showSpinner" type="boolean" default="false" />
    <aura:attribute name="isdeletable" type="Boolean"  />
  
   <lightning:card title="Upload Document" iconName="action:add_file">           
                <div class="slds-p-around_x-large">
         <table class="slds-table slds-table--bordered slds-table--cell-buffer slds-max-medium-table--stacked-horizontal">
                        <thead>
                            <tr class="slds-line-height_reset">
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Name">Document Name</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Description">Description</div>
                                </th>
                                <aura:if isTrue="{!v.doclink}">
                                    <th class="" scope="col">
                                        <div class="slds-truncate" title="Document Link">Document Link</div>
                                    </th>
                                </aura:if>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Upload File">Upload File</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Uploaded">Uploaded</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="Delete">Delete</div>
                                </th> 
                            </tr>
                        </thead>
              <tbody>     
                            <aura:iteration items="{!v.iteratorList}" var="item" indexVar="index">                            
                                <tr>
                                    <th scope="row" data-label="Document Name">
                                        
                                        <aura:if isTrue="{!item.required.length > 0}">
                                            <span style="color:red;">*</span>{!item.key}
                                            <aura:set attribute="else">
                                                <span>&nbsp;&nbsp;</span>{!item.key}                                        
                                            </aura:set>
                                        </aura:if> 
                                    </th>
                                    <th scope="row" data-label="Description">
                                        <aura:if isTrue="{!item.dis.length > 0}">
                                                <div  title="" class="slds-truncate">
                                                    <aura:if isTrue="{!item.required.length > 0}">
                                                    <a onclick="{!c.handleShowPopover}" data-index="{!'*'+item.key}">View Description</a>
                                                        <aura:set attribute="else">
                                                            <a onclick="{!c.handleShowPopover}" data-index="{!item.key}">View Description</a>
                                                        </aura:set>
                                                    </aura:if>
                                                </div>
                                            <aura:if isTrue="{!v.discription.length > 0}" >
                                            
                                            <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                                                <div class="slds-modal__container">
                                                    <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                                       
                                                        <div class="slds-align_absolute-center slds-text-heading_small slds-truncate slds-grow slds-cell-wrap">{!v.discription}</div>
                                                        <div class="slds-align_absolute-center slds-p-top_medium ">  <lightning:button variant="neutral" 
                                                                                                                                       label="OK"
                                                                                                                                       title="Cancel"
                                                                                                                                       onclick="{! c.closeModel }"/></div>
                                                    </div>  
                                                </div>
                                            </section>
                                            <div class="slds-backdrop slds-backdrop_open"></div>
                                            
                                        </aura:if>
                                        </aura:if>
                                        </th>
                                    <aura:if isTrue="{!v.doclink}">
                                        <th scope="row" data-label="Document Link">
                                            <aura:if isTrue="{!and(item.link.length > 0,item.value.length > 0)}">
                                                <div class="slds-truncate" title="">
                                                    <a onclick="{!c.handleClick}" data-index="{!item.link}">View Document</a>
                                                </div>
                                            </aura:if>
                                        </th>
                                    </aura:if>
                                    <th scope="row" data-label="Upload File">
                                        <div class="slds-truncate" >
                                            <lightning:fileUpload title="{!item.key}"
                                                                  aura:id="FileUpload" 
                                                                  name="{!index}"
                                                                  multiple="false"
                                                                  accept=".jpg,.jpeg,.png,.pdf,.docx,.xls,.csv"
                                                                  recordId="{!item.Id}"
                                                                  onuploadfinished="{!c.handleUploadFinished}"
                                                                  disabled="{!v.isdeletable}" /> 
                                            
                                        </div>                           
                                    </th>
                                    <th scope="row" data-label="Uploaded">
                                        <div class="slds-truncate" title="uploaded">
                                            <aura:if isTrue="{!item.value.length > 0}">
                                                <lightning:icon iconName="action:check" alternativeText="Check" size="xx-small" />
                                                <aura:set attribute="else">
                                                    <lightning:icon iconName="action:close" alternativeText="Uncheck" size="xx-small" />                                     
                                                </aura:set>
                                            </aura:if>                                                                        
                                        </div>
                                    </th> 
                                    <th scope="row" data-label="Delete">
                                        <aura:if isTrue="{!item.docId.length > 0}">
                                            <lightning:button variant="brand" label="Delete" value="{!item.Id}" name="{!item.docId}" onclick="{!c.deleltedoc}" disabled="{!v.isdeletable}" />   
                                        </aura:if>    
                                    </th>
                                </tr>     
                            </aura:iteration>
                        </tbody>
                    </table>
        
          <aura:if isTrue="{!v.iteratorList.length == 0}">
            <div class="slds-border_top slds-text-align_center slds-p-around_small slds-text-heading_small">
                No Document Found
            </div>
        </aura:if>
       </div>
    </lightning:card>
</aura:component>