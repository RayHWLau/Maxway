<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global" controller="SchoolSearchAura">
<aura:handler name="init" value="{!this}" action="{!c.doint}" />
    <aura:attribute name="ScheoolColumns" type="List"/>
    <aura:attribute name="ScheoolRecords" type="List"/>
    <aura:attribute name="contract" type="string"/>
    <aura:attribute name="showdata" type="boolean"/>
    <aura:if isTrue ="{!v.showdata}">
    <lightning:card  title="{!v.contract}" iconName="standard:contract">
        <aura:set attribute="actions">
            <lightning:button label="New" onclick ="{!c.redirect}"/>
        </aura:set>
        <p class="slds-p-horizontal_small">
          <lightning:datatable data="{! v.ScheoolRecords }" 
                             columns="{! v.ScheoolColumns }" 
                             keyField="Id" 
                             hideCheckboxColumn="true"
                             showRowNumberColumn="true"
                             class ="slds-table slds-table_bordered"
                            />    
        </p>
    </lightning:card>
    </aura:if>
</aura:component>