<aura:component implements="force:lightningQuickActionWithoutHeader,force:hasRecordId" controller="OpportunityApprovalController">	
   <aura:attribute name="conformation" type="boolean" default="true" />
    <aura:attribute name="showSpinner" type="boolean" default="false" />
    <aura:attribute name="msg" type="string" default="Do you want to sent Opportunity for approval?" />    
  <!--  <aura:if isTrue="{!v.showSpinner}">
                <lightning:spinner name="spinner" size="small" variant="brand" />
            </aura:if> -->
    <aura:if isTrue="{!!v.showSpinner}">
    <div class="slds-align_absolute-center slds-text-heading_small " >{!v.msg}</div>
    <div class="slds-align_absolute-center slds-p-top_medium ">
        <aura:if isTrue ="{!v.conformation}">
        <lightning:button variant="neutral" label="Cancel"  onclick="{!c.closeaction}"/>
        <lightning:button variant="Brand" label="OK" onclick="{!c.doInit}" />
            </aura:if>
        <aura:if isTrue ="{!!v.conformation}">
            <lightning:button variant="Brand" label="OK"  onclick="{!c.closeaction}"/>
        </aura:if>
        </div> 
    </aura:if>
</aura:component>