<aura:component implements="force:hasRecordId,lightning:actionOverride,force:lightningQuickActionwithoutheader,flexipage:availableForRecordHome" access="global">
	<aura:attribute name="recordId" type="String" />
        <lightning:overlayLibrary aura:id="overlayLib"/>  	
    <aura:handler name = "init" value = "{!this}" action = "{!c.doinit}" />
</aura:component>